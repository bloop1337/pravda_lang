% Стандратная библиотека языка программирования Правда

% Публичные константы
МИНИМАЛЬНОЕ_ЦЕЛОЕ:  конст цел = -2147483648;
МАКСИМАЛЬНОЕ_ЦЕЛОЕ: конст цел = 2147483647;
МИНИМАЛЬНОЕ_НАТ:  конст нат = 0;
МАКСИМАЛЬНОЕ_НАТ: конст нат = 4294967295;

% Частные константы
__СИМВОЛ_ДЛЯ_ФОРМАТИРОВАНИЯ__: конст cимвол = "?";

% ВВОД/ВЫВОД
% Выводит строку в стандартный вывод
% Но перед этим форматирует ее, заменяет (__символ_для_форматирования__)
% на переданные аргументы(при наличии)
% если аргументов > чем символов, игнорирует последнии
фн печатай(что: Строка, аргументы: ...): ничего;

% Читает строку с стандартного ввода
фн прочитай(): Строка;

% ЛОГИКА
% Возвращает не что
фн не(что: лог): лог;
фн между(что: цел, а: цел, б: цел): лог;
фн нат_между(что: нат, а: нат, б: нат): лог;
фн дробь_между(что: дробь, а: дробь, б: дробь): лог;
фн точн_между(что: точн, а: точн, б: точн): лог;
фн длин_между(что: длин, а: длин, б: длин): лог;

% Утилиты
фн загадай(): длин;
фн загадай_до(чего: длин): длин;
фн загадай_от_до(от: длин, до: длин): длин;

% возвращает системное время в милисекундах
фн системное_время_мс(): длин;

% возвращает системное время в нано секундах
фн системное_время_нс(): длин;

% выполняет ассемблер
фн выполни_асм(асм: Строка): ничего;
